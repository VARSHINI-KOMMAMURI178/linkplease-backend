# Your PseudoGram API key (from POST /v1/keygen). Used both to auth outbound
# calls (X-API-Key) and to verify inbound webhook signatures (HMAC secret).
PSEUDOGRAM_API_KEY=

PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com

# Point this at a persistent disk in production (e.g. Render disk mounted at /data).
DB_PATH=./data/linkplease.db

RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_SEND_ATTEMPTS_PER_CYCLE=5
MAX_SEND_CYCLES=3
